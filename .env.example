# Choose one provider for CLI (UI can override this selection).
LLM_PROVIDER=deepseek

# DeepSeek (official current model name: deepseek-flash)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# OpenRouter: select a model slug shown at https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional OpenRouter attribution headers:
# OPENROUTER_APP_URL=
# OPENROUTER_APP_NAME=Web GUI Testing Agent

# OpenAI (optional, NOT required)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=

# auto = JSON mode for DeepSeek/OpenAI, plain-text JSON for OpenRouter.
# If your chosen OpenRouter model supports it, switch to on.
LLM_JSON_MODE=auto

# Optional local Chrome configuration:
# CHROME_BINARY=
# CHROMEDRIVER_PATH=
