# Choose one provider for CLI (UI can override this selection).
LLM_PROVIDER=deepseek

# DeepSeek (official current model name: deepseek-flash)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# OpenRouter: select a model slug shown at https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional OpenRouter attribution headers:
# OPENROUTER_APP_URL=
# OPENROUTER_APP_NAME=Web GUI Testing Agent

# OpenAI (optional, NOT required)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=

# SiliconFlow / 硅基流动 (OpenAI-compatible; model ID is editable in UI)
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# UI shows public model/base settings, NEVER preloads these keys.
# UI tasks require the current user's password input; CLI retains env/.env keys.
# auto = JSON mode for DeepSeek/OpenAI, prompt JSON for OpenRouter/SiliconFlow.
# If your chosen OpenRouter model supports it, switch to on.
LLM_JSON_MODE=auto

# Optional local Chrome configuration:
# CHROME_BINARY=
# CHROMEDRIVER_PATH=
